// Function helper to estimate sugar based on selected item, MQ sensors & Temperature
float calculateNIRSugar(String fruit, int mq4, int mq135, float temp) {
  float baseBrix = 12.0;
  if (fruit == "Apple") baseBrix = 14.5;
  else if (fruit == "Banana") baseBrix = 18.2;
  else if (fruit == "Tomato") baseBrix = 4.8;
  else if (fruit == "Onion") baseBrix = 9.1;
  else if (fruit == "Guava") baseBrix = 10.5;
  else if (fruit == "Leafy Vegetables") baseBrix = 3.2;

  // Temperature variation factor
  float tempOffset = (isnan(temp) || temp == 0) ? 0.0 : ((temp - 25.0) * 0.1);

  // Spoilage / Gas impact factor
  if (mq4 > SPOILAGE_THRESHOLD_MQ4 || mq135 > SPOILAGE_THRESHOLD_MQ135 || isSpoilAlertActive) {
    baseBrix = baseBrix * 0.4; // Sugar depletion on spoiled items
  } else {
    baseBrix += tempOffset;
  }

  if (baseBrix < 1.0) baseBrix = 1.0;
  return baseBrix;
}

