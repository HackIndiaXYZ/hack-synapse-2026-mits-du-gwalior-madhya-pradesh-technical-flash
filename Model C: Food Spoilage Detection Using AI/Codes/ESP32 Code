// ====================================================================
// 5. DIAGNOSTIC INITIALIZATION
// ====================================================================
void setup() {
  delay(5000); 

  Serial.begin(115200);
  
  pinMode(BUZZER_PIN, OUTPUT);
  pinMode(RELAY_PIN, OUTPUT);
  digitalWrite(BUZZER_PIN, LOW);
  digitalWrite(RELAY_PIN, LOW); 

  pinMode(DHT1_PIN, INPUT_PULLUP);
  pinMode(DHT2_PIN, INPUT_PULLUP);

  dht1.begin();
  dht2.begin();
  
  pinMode(IR_FRUIT_PIN, INPUT);
  pinMode(MQ4_ANALOG, INPUT);
  pinMode(MQ135_ANALOG, INPUT);

  Wire.begin(21, 22);
  Wire.beginTransmission(0x27);
  if (Wire.endTransmission() == 0) {
    lcd.init();
    lcd.backlight();
    lcd.setCursor(0, 0);
    lcd.print("    VEGETABLE    ");
    lcd.setCursor(0, 1);
    lcd.print("SPOILER DETECTCN");
    lcdStatus = true;
  }

  digitalWrite(BUZZER_PIN, HIGH);
  delay(150);
  digitalWrite(BUZZER_PIN, LOW);

  WiFi.mode(WIFI_STA); 
  WiFi.disconnect();
  delay(100);

  WiFi.begin(ssid, password);
  Serial.print("Connecting to Hotspot");
  
  int attemptCounter = 0;
  while (WiFi.status() != WL_CONNECTED && attemptCounter < 25) {
    delay(500);
    Serial.print(".");
    attemptCounter++;
  }

  if(WiFi.status() == WL_CONNECTED) {
    Serial.println("\n🎉 Connected Successfully!");
    Serial.print("Local IP Address: ");
    Serial.println(WiFi.localIP());
  } else {
    Serial.println("\n⚠️ WiFi reconnecting in background...");
  }

  server.on("/", handleRootPage);
  server.on("/api/data", handleJSONDataFeed);
  server.on("/api/select", handleSelectionChange);
  server.on("/api/scan-trigger", handleScanTrigger);
  server.on("/api/download-single", handleSingleDownload);
  server.on("/api/download-all", handleMasterDownload);
  server.begin();

  delay(2000); 
  if (lcdStatus) lcd.clear();
}

// ====================================================================
// 6. MAIN RUNNING SYSTEM LOOP
// ====================================================================
void loop() {
  server.handleClient(); 

  if (WiFi.status() != WL_CONNECTED) {
     static unsigned long lastReconnectAttempt = 0;
     if (millis() - lastReconnectAttempt >= 8000) {
        lastReconnectAttempt = millis();
        WiFi.begin(ssid, password);
     }
  }

  unsigned long currentMillis = millis();
  if (currentMillis - previousMillis >= interval) {
    previousMillis = currentMillis;

    fruitDetected = (digitalRead(IR_FRUIT_PIN) == LOW) ? 1 : 0; 
    
    humidity1 = dht1.readHumidity();
    temperature1 = dht1.readTemperature(); 
    humidity2 = dht2.readHumidity();
    temperature2 = dht2.readTemperature(); 
    
    rawMQ4 = analogRead(MQ4_ANALOG);
    rawMQ135 = analogRead(MQ135_ANALOG);

    // Calculate dynamic sugar brix whenever sensor data is read
    dynamicSugarBrix = calculateNIRSugar(selectedFruit, rawMQ4, rawMQ135, temperature1);

    if (fruitDetected == 1 && prevFruitDetected == 0) {
      digitalWrite(BUZZER_PIN, HIGH); delay(150); digitalWrite(BUZZER_PIN, LOW);
      prevFruitDetected = 1; 
      scanStatusString = "Awaiting Scan..."; 
    } else if (fruitDetected == 0) {
      prevFruitDetected = 0; 
      isSpoilAlertActive = false; 
      scanStatusString = "Awaiting Scan...";
    }

    // Humidifier Control Relay Logic
    if (fruitDetected == 1 && temperature1 < 45.0) {
      digitalWrite(RELAY_PIN, HIGH); 
      isHumidifierOn = true;
    } else {
      digitalWrite(RELAY_PIN, LOW);  
      isHumidifierOn = false;
    }

    Serial.print("[IP: "); Serial.print(WiFi.localIP()); Serial.print("] ");
    Serial.print("T:" + String(temperature1, 0) + "C Sugar:" + String(dynamicSugarBrix, 1) + " Brix ");
    Serial.println("MQ4:" + String(rawMQ4) + " MQ135:" + String(rawMQ135));

    if (lcdStatus && scanStatusString == "Awaiting Scan...") {
      String t1Out = isnan(temperature1) ? "ER" : String(temperature1, 0);
      String h1Out = isnan(humidity1) ? "ER" : String(humidity1, 0);

      char row0[17];
      char row1[17];
      
      snprintf(row0, sizeof(row0), "T:%sH:%sMe:%d", t1Out.c_str(), h1Out.c_str(), rawMQ4);
      snprintf(row1, sizeof(row1), "MQ135:%d Sugar:%.1f", rawMQ135, dynamicSugarBrix);

      lcd.setCursor(0, 0);
      lcd.print(row0);
      lcd.setCursor(0, 1);
      lcd.print(row1);
    }
  }
}
