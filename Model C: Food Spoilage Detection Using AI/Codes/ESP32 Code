  String t2Str = isnan(temperature2) ? "ERR" : String(temperature2, 0);
  String h2Str = isnan(humidity2) ? "ERR" : String(humidity2, 0);

  String sugarDescStr = isSpoilAlertActive ? "Decayed - Microbial Depletion" : "Optimal Ripeness";

  String json = "{";
  json += "\"fruit\":" + String(fruitDetected) + ",";
  json += "\"temperature1\":\"" + t1Str + "\",";
  json += "\"humidity1\":\"" + h1Str + "\",";
  json += "\"temperature2\":\"" + t2Str + "\",";
  json += "\"humidity2\":\"" + h2Str + "\",";
  json += "\"mq4\":" + String(rawMQ4) + ",";
  json += "\"mq135\":" + String(rawMQ135) + ",";
  json += "\"blemish\":" + String(currentBlemish, 0) + ",";
  json += "\"spoilIndex\":" + String(currentSpoilageIndex, 0) + ",";
  json += "\"scanStatus\":\"" + scanStatusString + "\",";
  json += "\"selectedItem\":\"" + selectedFruit + "\",";
  json += "\"sugarContent\":" + String(dynamicSugarBrix, 1) + ","; 
  json += "\"sugarDesc\":\"" + sugarDescStr + "\",";
  json += "\"humidifier\":" + String(isHumidifierOn ? 1 : 0);
  json += "}";
  server.send(200, "application/json", json);
}

void handleSelectionChange() {
  if (server.hasArg("item")) {
    selectedFruit = server.arg("item");
    Serial.println("Target Item Changed To: " + selectedFruit);
    dynamicSugarBrix = calculateNIRSugar(selectedFruit, rawMQ4, rawMQ135, temperature1);
  }
  server.send(200, "text/plain", "OK");
}

void handleScanTrigger() {
  if (server.hasArg("status")) {
    String currentStatus = server.arg("status");
    if (currentStatus == "run") {
      scanStatusString = "AI Image Processing...";
      currentBlemish = 0.0;
      currentSpoilageIndex = 0.0;
      if (lcdStatus) {
        lcd.clear();
        lcd.setCursor(0,0);
        lcd.print("Capturing Photo ");
        lcd.setCursor(0,1);
        lcd.print("Processing Image");
      }
    } else if (currentStatus == "complete") {
      if (rawMQ4 > SPOILAGE_THRESHOLD_MQ4 || rawMQ135 > SPOILAGE_THRESHOLD_MQ135) {
        scanStatusString = "DO NOT EAT!"; 
        isSpoilAlertActive = true;
        currentBlemish = 74.5;
        currentSpoilageIndex = 96.0;
        
        for(int i = 0; i < 3; i++) {
          digitalWrite(BUZZER_PIN, HIGH); delay(200);
          digitalWrite(BUZZER_PIN, LOW); delay(150);
        }
        
        if (lcdStatus) {
          lcd.clear();
          lcd.setCursor(0,0);
          lcd.print(selectedFruit + ":Spoiled");
          lcd.setCursor(0,1);
          lcd.print("Not Eatable     "); 
        }
      } else {
        scanStatusString = "SAFE TO EAT ✓"; 
        isSpoilAlertActive = false;
        currentBlemish = 4.2;
        currentSpoilageIndex = 8.5;
        
        for(int i = 0; i < 2; i++) {
          digitalWrite(BUZZER_PIN, HIGH); delay(200);
          digitalWrite(BUZZER_PIN, LOW); delay(150);
        }
        
        if (lcdStatus) {
          lcd.clear();
          lcd.setCursor(0,0);
          lcd.print(selectedFruit + ":Fresh  ");
          lcd.setCursor(0,1);
          lcd.print("Eatable ✓       ");
        }
      }
      dynamicSugarBrix = calculateNIRSugar(selectedFruit, rawMQ4, rawMQ135, temperature1);
    }
  }
  server.send(200, "text/plain", "OK");
}

